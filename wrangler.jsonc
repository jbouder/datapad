{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "datapad",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // The Vite plugin fills in `assets.directory` with the client build.
  // Every request reaches the Worker first, assets included, so the Access
  // check in worker/access.ts covers index.html too. Unknown paths fall back
  // to the single-page app, so deep links like /projects/abc load it.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  // One Durable Object per signed-in user, named by the verified email. Its
  // SQLite storage *is* the database. Nothing is ever wiped.
  "durable_objects": {
    "bindings": [{ "name": "DATAPAD", "class_name": "DatapadObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DatapadObject"] }],

  // Nightly backups: each object writes its export here at BACKUP_HOUR in
  // BACKUP_TIME_ZONE and keeps the latest 30. Create the bucket once:
  // `npx wrangler r2 bucket create datapad-backups` (docs/self-hosting.md).
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "datapad-backups" }],

  // MCP clients' OAuth state (#152): registered clients, grants, and
  // tokens and codes stored only as hashes. `wrangler deploy` creates the
  // namespace the first time and keeps using it; to make it yourself,
  // `npx wrangler kv namespace create OAUTH_KV` and add its `id` here
  // (docs/self-hosting.md).
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],

  // `/oauth/register` is open to anyone (an MCP client cannot sign in with
  // Access), and every registration is a KV write. This caps it per client
  // IP (#225, worker/mcp/oauth.ts). `namespace_id` is any positive integer
  // of your choosing, unique among the rate limiters in your account.
  "ratelimits": [
    {
      "name": "REGISTER_LIMIT",
      "namespace_id": "225",
      "simple": { "limit": 5, "period": 60 }
    }
  ],

  // Cloudflare Access (Zero Trust). Both values are public. With ACCESS_AUD
  // empty the Worker answers 401 to everything, unless .dev.vars sets
  // DEV_ACCESS_EMAIL for local development. See docs/self-hosting.md.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "broad-term-b836.cloudflareaccess.com",
    "ACCESS_AUD": "d62a172b799c1ce9fc8be3e15256b4546a79684dfef02e7d491491d112b3f1c2",
    "BACKUP_HOUR": "3",
    "BACKUP_TIME_ZONE": "America/New_York",
    // Days to keep the before-* copies written before an erase, delete,
    // import or restore; the nightly backup deletes older ones. Empty (the
    // default) keeps them until you delete them. See docs/data.md.
    "BEFORE_COPIES_MAX_DAYS": ""
  },

  "observability": { "enabled": true },

  // Staging (#327): the v2 trunk, deployed by .github/workflows/deploy.yml
  // after CI passes on a push to `v2`. Built with `CLOUDFLARE_ENV=staging`,
  // so the Vite plugin writes this environment's config for `wrangler
  // deploy`. Nothing is shared with production: its own Worker (and so its
  // own DATAPAD namespace), backups bucket, OAUTH_KV, rate limiter and
  // Access application. Bindings and vars are not inherited, so each one is
  // restated here. See docs/self-hosting.md § Staging.
  "env": {
    "staging": {
      "name": "datapad-v2",
      "durable_objects": {
        "bindings": [{ "name": "DATAPAD", "class_name": "DatapadObject" }]
      },
      "r2_buckets": [
        { "binding": "BACKUPS", "bucket_name": "datapad-v2-backups" }
      ],
      // No id: the first deploy creates this Worker's own namespace.
      "kv_namespaces": [{ "binding": "OAUTH_KV" }],
      "ratelimits": [
        {
          "name": "REGISTER_LIMIT",
          "namespace_id": "327",
          "simple": { "limit": 5, "period": 60 }
        }
      ],
      "vars": {
        "ACCESS_TEAM_DOMAIN": "broad-term-b836.cloudflareaccess.com",
        "ACCESS_AUD": "2c401460ff80c4fc90db77c3fd0aad67a3952e534f2832d72cdc867142e075ae",
        "BACKUP_HOUR": "3",
        "BACKUP_TIME_ZONE": "America/New_York",
        "BEFORE_COPIES_MAX_DAYS": ""
      },
      "observability": { "enabled": true }
    }
  }
}
