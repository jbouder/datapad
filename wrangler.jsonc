{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "datapad",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // The Vite plugin fills in `assets.directory` with the client build.
  // Every request reaches the Worker first, assets included, so the Access
  // check in worker/access.ts covers index.html too. Unknown paths fall back
  // to the single-page app, so deep links like /projects/abc load it.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  // One Durable Object per signed-in user, named by the verified email. Its
  // SQLite storage *is* the database. Nothing is ever wiped.
  "durable_objects": {
    "bindings": [{ "name": "DATAPAD", "class_name": "DatapadObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DatapadObject"] }],

  // Nightly backups: each object writes its export here at BACKUP_HOUR in
  // BACKUP_TIME_ZONE and keeps the latest 30. Create the bucket once:
  // `npx wrangler r2 bucket create datapad-backups` (docs/self-hosting.md).
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "datapad-backups" }],

  // MCP clients' OAuth state (#152): registered clients, grants, and
  // tokens and codes stored only as hashes. `wrangler deploy` creates the
  // namespace the first time and keeps using it; to make it yourself,
  // `npx wrangler kv namespace create OAUTH_KV` and add its `id` here
  // (docs/self-hosting.md).
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],

  // Cloudflare Access (Zero Trust). Both values are public. With ACCESS_AUD
  // empty the Worker answers 401 to everything, unless .dev.vars sets
  // DEV_ACCESS_EMAIL for local development. See docs/self-hosting.md.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "broad-term-b836.cloudflareaccess.com",
    "ACCESS_AUD": "d62a172b799c1ce9fc8be3e15256b4546a79684dfef02e7d491491d112b3f1c2",
    "BACKUP_HOUR": "3",
    "BACKUP_TIME_ZONE": "America/New_York"
  },

  "observability": { "enabled": true }
}
