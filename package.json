{
  "name": "datapad",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "wrangler types && tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "test": "wrangler types && vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:changed": "playwright test --only-changed=main",
    "e2e:ui": "playwright test --ui",
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "types": "wrangler types",
    "tail": "wrangler tail",
    "icons": "node --experimental-strip-types scripts/icons.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/oxanium": "^5.3.0",
    "@mlc-ai/web-llm": "^0.2.85",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "idb-keyval": "^6.3.0",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.0",
    "shadcn": "^4.15.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.4.15",
    "@cloudflare/vite-plugin": "^1.62.0",
    "@cloudflare/vitest-plugin": "^1.3.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.5",
    "wrangler": "^4.147.0"
  }
}
